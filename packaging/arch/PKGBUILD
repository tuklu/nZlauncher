# Maintainer: tuklu
pkgname=nzlauncher-git
pkgver=r32.3becc3e
pkgrel=1
pkgdesc="Launcher for Hyprland that learns how you use it"
arch=('x86_64' 'aarch64')
url="https://github.com/tuklu/nZlauncher"
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'glib2' 'hyprland')
makedepends=('go' 'git')
optdepends=(
  'ghostty: TUI face'
  'cliphist: clipboard provider'
  'wl-clipboard: clipboard provider, copying results'
  'bluez-utils: bluetooth provider'
  'iwd: wifi provider'
  'fd: file search'
  'fzf: nzlauncher pick'
  'hyprmoncfg: monitor provider'
  'swaybg: default wallpaper command'
)
# LTO and a debug package buy nothing for cgo wrappers, and LTO makes gcc
# crawl through gotk4's huge generated C file
options=('!lto' '!debug')
provides=('nzlauncher')
conflicts=('nzlauncher')
source=("git+https://github.com/tuklu/nZlauncher.git")
sha256sums=('SKIP')

pkgver() {
  cd nZlauncher
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd nZlauncher
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  # the CLI has no cgo, so every command starts without loading GTK
  CGO_ENABLED=0 go build -ldflags "-X main.version=$pkgver" -o nzlauncher ./cmd/nzlauncher
  go build -o nzlauncher-gtk ./cmd/nzlauncher-gtk
}

package() {
  cd nZlauncher
  install -Dm755 nzlauncher "$pkgdir/usr/bin/nzlauncher"
  install -Dm755 nzlauncher-gtk "$pkgdir/usr/bin/nzlauncher-gtk"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/systemd/nzlauncher.service "$pkgdir/usr/lib/systemd/user/nzlauncher.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # the manual and completions are built into the binary
  local bin="$pkgdir/usr/bin/nzlauncher"
  install -d "$pkgdir/usr/share/man/man1" "$pkgdir/usr/share/zsh/site-functions" \
    "$pkgdir/usr/share/bash-completion/completions" "$pkgdir/usr/share/fish/vendor_completions.d"
  "$bin" man > "$pkgdir/usr/share/man/man1/nzlauncher.1"
  "$bin" completion zsh > "$pkgdir/usr/share/zsh/site-functions/_nzlauncher"
  "$bin" completion bash > "$pkgdir/usr/share/bash-completion/completions/nzlauncher"
  "$bin" completion fish > "$pkgdir/usr/share/fish/vendor_completions.d/nzlauncher.fish"
}
